{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"noEmit": false,
		"emitDeclarationOnly": true,
		"declaration": true,
		"outDir": "dist",
		"rootDir": "src",
		"types": ["node"]
	},
	"include": ["src/**/*.ts"],
	"exclude": [
		"node_modules",
		"src/cli.ts",
		"src/cli.standalone.ts",
		"src/register.ts",
		"src/register.standalone.ts"
	]
}
